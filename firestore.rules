rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les scores sont rangés sous un "code secret" (rooms/{code}/games).
    // Personne ne peut lister les codes : il faut connaître le vôtre pour lire ou écrire.
    function validGame(d) {
      return d.keys().hasOnly(['name', 'players', 'points', 'sets', 'setsMode', 'setTarget', 'order', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() <= 60
        && d.players is list && d.players.size() >= 2 && d.players.size() <= 12
        && d.points is map && d.sets is map
        && d.setsMode is bool
        && d.setTarget is int && d.setTarget >= 1 && d.setTarget <= 99
        && (d.order == null || d.order is number);
    }

    match /rooms/{room}/games/{game} {
      allow read, delete: if room.size() >= 8;
      allow create, update: if room.size() >= 8 && validGame(request.resource.data);

      // Historique des points d'un jeu
      match /events/{event} {
        allow read, delete: if room.size() >= 8;
        allow create: if room.size() >= 8
          && request.resource.data.keys().hasOnly(['type', 'text', 'n', 'playerId', 'delta', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 200;
      }
    }
  }
}
