rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les scores sont rangés sous un "code secret" (rooms/{code}/games).
    // Personne ne peut lister les codes : il faut connaître le vôtre pour lire ou écrire.
    match /rooms/{room}/games/{game} {
      allow read, delete: if room.size() >= 8;
      allow create, update: if room.size() >= 8
        && request.resource.data.keys().hasOnly(['name', 'p1', 'p2', 's1', 's2', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.p1 is string && request.resource.data.p1.size() <= 20
        && request.resource.data.p2 is string && request.resource.data.p2.size() <= 20
        && request.resource.data.s1 is int && request.resource.data.s2 is int;
    }
  }
}
